<UserControl x:Class="Gym.UI.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topbar -->
        <Border Background="White" Grid.Row="0" Height="70">
            <Border.Effect>
                <DropShadowEffect Color="#E5E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid Margin="30,0">
                <TextBlock Text="Gestión de Socios" FontSize="22" FontWeight="Bold" Foreground="#1C1833" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Acciones -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E8F0" BorderThickness="1" Padding="10,0" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="#A0A0B5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Grid.Column="1" Height="35">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Content="Buscar" Command="{Binding SearchCommand}" Background="#F4F6FB" Foreground="#555870" FontWeight="SemiBold" Padding="15,8" BorderBrush="#E5E8F0" BorderThickness="1" Cursor="Hand" Margin="10,0,0,0" Grid.Column="1" HorizontalAlignment="Left">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="+ Nuevo Socio" Command="{Binding OpenAddMemberCommand}" Background="#5C4DFF" Foreground="White" FontWeight="SemiBold" Padding="15,8" BorderThickness="0" Cursor="Hand" Grid.Column="2">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Tabla -->
            <Border Background="White" CornerRadius="12" Grid.Row="1">
                <Border.Effect>
                    <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="25,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nombre completo" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="0" />
                        <TextBlock Text="Plan" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                        <TextBlock Text="Vencimiento" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="2" />
                        <TextBlock Text="Estado" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="3" />
                        <TextBlock Text="Acciones" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="4" HorizontalAlignment="Center"/>
                    </Grid>
                    
                    <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#F0F2F8" Margin="0" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="60" Margin="25,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FullName}" Foreground="#1C1833" VerticalAlignment="Center" FontWeight="SemiBold" Grid.Column="0" />
                                            <TextBlock Text="{Binding PlanType}" Foreground="#555870" VerticalAlignment="Center" Grid.Column="1" />
                                            <TextBlock Text="{Binding ExpirationDate, StringFormat='dd MMM yyyy'}" Foreground="#555870" VerticalAlignment="Center" Grid.Column="2" />
                                            <Border CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4" Grid.Column="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MembershipStatus}" Value="Activo">
                                                                <Setter Property="Background" Value="#E6F7F0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MembershipStatus}" Value="Vencido">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding MembershipStatus}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MembershipStatus}" Value="Activo">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MembershipStatus}" Value="Vencido">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <!-- Actions Menu Button -->
                                            <Button Content="⋮" Grid.Column="4" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#888C9B" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,0" Click="MenuButton_Click"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Editar" 
                                                                  Command="{Binding PlacementTarget.Tag.EditMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="Renovar (1 Mes)" 
                                                                  Command="{Binding PlacementTarget.Tag.RenewMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="Desactivar" 
                                                                  Command="{Binding PlacementTarget.Tag.DeactivateMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                  CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                        <Separator Background="#F0F2F8" Margin="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>