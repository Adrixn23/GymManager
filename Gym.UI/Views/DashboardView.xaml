<UserControl x:Class="Gym.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <!-- Area Principal -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topbar -->
        <Border Background="White" Grid.Row="0" Height="70">
            <Border.Effect>
                <DropShadowEffect Color="#E5E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid Margin="30,0">
                <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1C1833" VerticalAlignment="Center" HorizontalAlignment="Left" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDate}" FontSize="14" Foreground="#888C9B" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido del Dashboard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0">
            <StackPanel Margin="30">
                
                <!-- Tarjetas de Resumen (KPIs) -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" CornerRadius="12" Padding="20" Grid.Column="0" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="8" Background="#EBF4FF" HorizontalAlignment="Left" Margin="0,0,0,15">
                                <TextBlock Text="👤" Foreground="#3B82F6" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ActiveMembersCount}" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                            <TextBlock Text="Socios activos" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                            <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                <TextBlock Text="↑ Al día" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20" Grid.Column="1" Margin="10,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="$" Foreground="#10B981" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,15" />
                            <TextBlock Text="RD$0" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                            <TextBlock Text="Ingresos hoy" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                            <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                <TextBlock Text="↑ 0%" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20" Grid.Column="2" Margin="10,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⬡" Foreground="#F59E0B" FontSize="32" Margin="0,-5,0,10" />
                            <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                            <TextBlock Text="Stock bajo" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                            <Border Background="#FEF3C7" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                <TextBlock Text="✓ OK" Foreground="#D97706" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20" Grid.Column="3" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="8" Background="#FEF2F2" HorizontalAlignment="Left" Margin="0,0,0,15">
                                <TextBlock Text="🔧" Foreground="#EF4444" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                            <TextBlock Text="Mantenimientos" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                            <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                <TextBlock Text="✓ Al día" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Lista de Socios Recientes -->
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="Socios recientes" FontSize="18" FontWeight="Bold" Foreground="#1C1833" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <!-- This button needs to call a command now -->
                    <Button Content="+ Nuevo Socio" Command="{Binding OpenAddMemberCommand}" Background="#5C4DFF" Foreground="White" FontWeight="SemiBold" Padding="15,8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
                
                <Border Background="White" CornerRadius="12" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="25,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nombre" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="0" />
                            <TextBlock Text="Plan" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                            <TextBlock Text="Vencimiento" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="2" />
                            <TextBlock Text="Estado" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="3" />
                        </Grid>
                        
                        <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#F0F2F8" Margin="0" />

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="60" Margin="25,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FullName}" Foreground="#1C1833" VerticalAlignment="Center" Grid.Column="0" />
                                            <TextBlock Text="{Binding PlanType}" Foreground="#555870" VerticalAlignment="Center" Grid.Column="1" />
                                            <TextBlock Text="{Binding ExpirationDate, StringFormat='dd MMM yyyy'}" Foreground="#555870" VerticalAlignment="Center" Grid.Column="2" />
                                            <Border CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4" Grid.Column="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MembershipStatus}" Value="Activo">
                                                                <Setter Property="Background" Value="#E6F7F0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MembershipStatus}" Value="Vencido">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding MembershipStatus}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MembershipStatus}" Value="Activo">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MembershipStatus}" Value="Vencido">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Separator Background="#F0F2F8" Margin="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensaje si no hay socios -->
                        <TextBlock Text="No hay socios registrados." 
                                   Visibility="{Binding Members.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                   Foreground="#888C9B" HorizontalAlignment="Center" Margin="0,30" Grid.Row="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Members.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>