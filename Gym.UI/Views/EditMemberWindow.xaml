<Window x:Class="Gym.UI.Views.EditMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Socio" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FB"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" Margin="20" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Editar Socio" FontSize="22" FontWeight="Bold" Foreground="#1C1833" Margin="0,0,0,20" Grid.Row="0"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Nombre Completo" Foreground="#555870" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#F4F6FB" CornerRadius="8" Padding="10,0" Height="40" Margin="0,0,0,15">
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14"/>
                </Border>

                <TextBlock Text="Correo Electrónico (Opcional)" Foreground="#555870" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#F4F6FB" CornerRadius="8" Padding="10,0" Height="40" Margin="0,0,0,15">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14"/>
                </Border>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo de Plan" Foreground="#555870" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#F4F6FB" CornerRadius="8" Padding="10,0" Height="40">
                            <ComboBox Text="{Binding PlanType}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14">
                                <ComboBoxItem Content="Diario"/>
                                <ComboBoxItem Content="Semanal"/>
                                <ComboBoxItem Content="Quincenal"/>
                                <ComboBoxItem Content="Mensual"/>
                                <ComboBoxItem Content="Anual"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Precio del Plan" Foreground="#555870" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#F4F6FB" CornerRadius="8" Padding="10,0" Height="40">
                            <TextBox Text="{Binding PlanPrice, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Estado" Foreground="#555870" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#F4F6FB" CornerRadius="8" Padding="10,0" Height="40" Margin="0,0,0,15">
                    <ComboBox Text="{Binding MembershipStatus}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14">
                        <ComboBoxItem Content="Activo"/>
                        <ComboBoxItem Content="Vencido"/>
                        <ComboBoxItem Content="Inactivo"/>
                    </ComboBox>
                </Border>
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,15" HorizontalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Cancelar" Click="Cancel_Click" Grid.Column="0" Background="Transparent" Foreground="#555870" FontWeight="SemiBold" BorderBrush="#D5D9E5" BorderThickness="1" Padding="0,10" Cursor="Hand" IsEnabled="{Binding IsBusy}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Guardar" Command="{Binding SaveCommand}" Grid.Column="2" Background="#5C4DFF" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="0,10" Cursor="Hand" IsEnabled="{Binding IsBusy}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>