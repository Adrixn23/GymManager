<Window x:Class="Gym.UI.Views.AddMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Socio" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FB"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Registrar Nuevo Socio" FontSize="20" FontWeight="Bold" Foreground="#1C1833" Grid.Row="0" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Nombre Completo *" Foreground="#888C9B" FontSize="12" Margin="0,0,0,5" />
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Background="White" BorderBrush="#E5E8F0" BorderThickness="1" Margin="0,0,0,15" />

            <TextBlock Text="Correo Electrónico (Opcional)" Foreground="#888C9B" FontSize="12" Margin="0,0,0,5" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="10" Background="White" BorderBrush="#E5E8F0" BorderThickness="1" Margin="0,0,0,15" />

            <TextBlock Text="Plan de Membresía" Foreground="#888C9B" FontSize="12" Margin="0,0,0,5" />
            <ComboBox Text="{Binding PlanType}" Padding="10" Background="White" BorderBrush="#E5E8F0" BorderThickness="1" Margin="0,0,0,15" IsEditable="True">
                <ComboBoxItem Content="Mensual" IsSelected="True"/>
                <ComboBoxItem Content="Trimestral" />
                <ComboBoxItem Content="Anual" />
            </ComboBox>

            <TextBlock Text="Precio (RD$)" Foreground="#888C9B" FontSize="12" Margin="0,0,0,5" />
            <TextBox Text="{Binding PlanPrice, UpdateSourceTrigger=PropertyChanged}" Padding="10" Background="White" BorderBrush="#E5E8F0" BorderThickness="1" Margin="0,0,0,15" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="Cancelar" Click="Cancel_Click" Grid.Column="0" Background="#E5E8F0" Foreground="#555870" FontWeight="SemiBold" Padding="0,12" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <Button Content="Guardar Socio" Command="{Binding SaveCommand}" Grid.Column="2" Background="#5C4DFF" Foreground="White" FontWeight="SemiBold" Padding="0,12" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>