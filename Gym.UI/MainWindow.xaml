<Window x:Class="Gym.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GymManager - Dashboard" Height="768" Width="1152"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB"
        FontFamily="Segoe UI">

    <!-- Estilos base para los botones del menú -->
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0B5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#2A2644"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="#5C4DFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#D5D9E5" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#1C1833" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo y Título -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,30,25,30">
                    <Grid Width="35" Height="25" Margin="0,0,10,0">
                        <Path Data="M 5,12.5 L 30,12.5 M 5,5 L 5,20 M 30,5 L 30,20 M 12,8 L 12,17 M 23,8 L 23,17" 
                              Stroke="#5C4DFF" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cil Gym SRL" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Sistema de Gestión" Foreground="#777494" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <Separator Background="#2A2644" Grid.Row="0" VerticalAlignment="Bottom" Margin="0" />

                <!-- Perfil de Usuario -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="25,30,25,30">
                    <!-- Avatar con iniciales -->
                    <Border Width="40" Height="40" CornerRadius="20" Background="#5C4DFF" Margin="0,0,15,0">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserFullName}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="140"/>
                        <TextBlock Text="{Binding UserRole}" Foreground="#777494" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Menú de Navegación -->
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource ActiveMenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,15,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,15,0" />
                            <TextBlock Text="Socios" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="$" FontFamily="Segoe UI Symbol" FontSize="16" Margin="4,0,18,0" />
                            <TextBlock Text="Finanzas" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬡" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,15,0" />
                            <TextBlock Text="Inventario" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,15,0" />
                            <TextBlock Text="Mantenimiento" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📉" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,15,0" />
                            <TextBlock Text="Egresos" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer / Logout -->
                <StackPanel Grid.Row="3">
                    <Separator Background="#2A2644" Margin="0" />
                    <Button Style="{StaticResource MenuButtonStyle}" Foreground="#FF6B6B">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[→" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,15,0" />
                            <TextBlock Text="Cerrar sesión" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área Principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Background="White" Grid.Row="0" Height="70">
                <Border.Effect>
                    <DropShadowEffect Color="#E5E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid Margin="30,0">
                    <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1C1833" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentDate}" FontSize="14" Foreground="#888C9B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Contenido del Dashboard -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0">
                <StackPanel Margin="30">
                    
                    <!-- Tarjetas de Resumen (KPIs) -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tarjeta 1: Socios -->
                        <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="8" Background="#EBF4FF" HorizontalAlignment="Left" Margin="0,0,0,15">
                                    <TextBlock Text="👤" Foreground="#3B82F6" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="142" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                                <TextBlock Text="Socios activos" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                                <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                    <TextBlock Text="↑ Al día" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 2: Ingresos -->
                        <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="10,0,10,0">
                            <StackPanel>
                                <TextBlock Text="$" Foreground="#10B981" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,15" />
                                <TextBlock Text="RD$8,400" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                                <TextBlock Text="Ingresos hoy" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                                <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                    <TextBlock Text="↑ 12%" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 3: Inventario -->
                        <Border Style="{StaticResource CardStyle}" Grid.Column="2" Margin="10,0,10,0">
                            <StackPanel>
                                <TextBlock Text="⬡" Foreground="#F59E0B" FontSize="32" Margin="0,-5,0,10" />
                                <TextBlock Text="3" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                                <TextBlock Text="Stock bajo" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                                <Border Background="#FEF3C7" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                    <TextBlock Text="⚠ Revisar" Foreground="#D97706" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 4: Mantenimiento -->
                        <Border Style="{StaticResource CardStyle}" Grid.Column="3" Margin="10,0,0,0">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="8" Background="#FEF2F2" HorizontalAlignment="Left" Margin="0,0,0,15">
                                    <TextBlock Text="🔧" Foreground="#EF4444" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="2" FontSize="28" FontWeight="Bold" Foreground="#1C1833" />
                                <TextBlock Text="Mantenimientos" FontSize="14" Foreground="#888C9B" Margin="0,0,0,15" />
                                <Border Background="#FEF2F2" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4">
                                    <TextBlock Text="! Urgente" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Lista de Socios Recientes -->
                    <TextBlock Text="Socios recientes" FontSize="18" FontWeight="Bold" Foreground="#1C1833" Margin="0,0,0,15" />
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Header de la tabla -->
                            <Grid Grid.Row="0" Margin="25,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nombre" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="0" />
                                <TextBlock Text="Plan" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                                <TextBlock Text="Vencimiento" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="2" />
                                <TextBlock Text="Estado" Foreground="#888C9B" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="3" />
                            </Grid>
                            
                            <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#F0F2F8" Margin="0" />

                            <!-- Filas (Mocks) -->
                            <StackPanel Grid.Row="1">
                                <!-- Fila 1 -->
                                <Grid Height="60" Margin="25,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Juan Pérez" Foreground="#1C1833" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Mensual" Foreground="#555870" VerticalAlignment="Center" Grid.Column="1" />
                                    <TextBlock Text="15 May 2026" Foreground="#555870" VerticalAlignment="Center" Grid.Column="2" />
                                    <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4" Grid.Column="3">
                                        <TextBlock Text="● Activo" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Separator Background="#F0F2F8" Margin="0" />

                                <!-- Fila 2 -->
                                <Grid Height="60" Margin="25,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="María López" Foreground="#1C1833" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Mensual" Foreground="#555870" VerticalAlignment="Center" Grid.Column="1" />
                                    <TextBlock Text="02 May 2026" Foreground="#555870" VerticalAlignment="Center" Grid.Column="2" />
                                    <Border Background="#FEF2F2" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4" Grid.Column="3">
                                        <TextBlock Text="● Vencido" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Separator Background="#F0F2F8" Margin="0" />

                                <!-- Fila 3 -->
                                <Grid Height="60" Margin="25,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carlos Díaz" Foreground="#1C1833" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Trimestral" Foreground="#555870" VerticalAlignment="Center" Grid.Column="1" />
                                    <TextBlock Text="30 Jun 2026" Foreground="#555870" VerticalAlignment="Center" Grid.Column="2" />
                                    <Border Background="#E6F7F0" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4" Grid.Column="3">
                                        <TextBlock Text="● Activo" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Separator Background="#F0F2F8" Margin="0" />

                                <!-- Fila 4 -->
                                <Grid Height="60" Margin="25,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ana Martínez" Foreground="#1C1833" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Mensual" Foreground="#555870" VerticalAlignment="Center" Grid.Column="1" />
                                    <TextBlock Text="10 May 2026" Foreground="#555870" VerticalAlignment="Center" Grid.Column="2" />
                                    <Border Background="#F3F4F6" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4" Grid.Column="3">
                                        <TextBlock Text="● Suspendido" Foreground="#6B7280" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>